{
  "name": "zaken-frontend",
  "version": "1.0.56",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "acc": "vite --mode acceptance",
    "build": "vite build",
    "generate:api-schema:local": "npx --yes openapi-typescript http://localhost:8080/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "generate:api-schema:acc": "npx --yes openapi-typescript https://acc.api.wonen.zaken.amsterdam.nl/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "lint": "eslint --max-warnings 0 --cache .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --mode development",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amsterdam/design-system-assets": "^2.6.0",
    "@amsterdam/design-system-css": "^4.4.0",
    "@amsterdam/design-system-react": "^4.4.0",
    "@amsterdam/design-system-react-icons": "^2.2.0",
    "@amsterdam/design-system-tokens": "^4.3.0",
    "@amsterdam/ee-ads-rhf": "^0.0.8",
    "@tanstack/react-query": "^5.104.1",
    "bpmn-js": "^18.31.0",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "lodash.debounce": "^4.0.8",
    "proj4": "^2.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-oidc-context": "^3.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/lodash.debounce": "^4.0.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.13",
    "vitest": "^5.0.1"
  }
}

{
  "name": "zaken-frontend",
  "version": "1.0.56",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "acc": "vite --mode acceptance",
    "build": "vite build",
    "deploy:prod": "npm version patch && git push origin HEAD --follow-tags",
    "swagger:generate-schema": "TS_NODE_PROJECT='./scripts/tsconfig.json' NODE_ENV='development' ts-node scripts/src/generateSwaggerSchema.ts",
    "lint": "eslint --max-warnings 0 --cache --ext .ts,.tsx src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "typecheck": "tsc --noEmit --incremental",
    "test": "env-cmd -f .env.development vitest run",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amsterdam/amsterdam-react-final-form": "^0.1.140",
    "@amsterdam/asc-assets": "^0.38.0",
    "@amsterdam/asc-ui": "^0.38.0",
    "@amsterdam/wonen-ui": "^1.0.82",
    "axios": "^1.16.1",
    "dayjs": "^1.11.13",
    "final-form": "^4.20.10",
    "final-form-arrays": "^3.0.2",
    "immer": "^11.1.3",
    "jwt-decode": "^4.0.0",
    "lodash.debounce": "^4.0.8",
    "lodash.isempty": "^4.4.0",
    "lodash.merge": "^4.6.2",
    "qs": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.30.3",
    "react-tooltip": "^6.0.3",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/react": "^13.4.0",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.isempty": "^4.4.7",
    "@types/lodash.merge": "^4.6.7",
    "@types/node": "^25.8.0",
    "@types/qs": "^6.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.26",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "dtsgenerator": "^3.19.2",
    "env-cmd": "^11.0.0",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.7"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
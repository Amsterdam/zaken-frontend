{
  "name": "zaken-frontend",
  "version": "1.0.56",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "acc": "vite --mode acceptance",
    "build": "vite build",
    "generate:api-schema:local": "npx --yes openapi-typescript http://localhost:8080/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "generate:api-schema:acc": "npx --yes openapi-typescript https://acc.api.wonen.zaken.amsterdam.nl/api/v1/schema/ -o ./src/__generated__/apiSchema.d.ts",
    "lint": "eslint --max-warnings 0 --cache --ext .ts,.tsx src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run --mode development",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amsterdam/amsterdam-react-final-form": "^0.1.140",
    "@amsterdam/asc-assets": "^0.38.0",
    "@amsterdam/asc-ui": "^0.38.0",
    "@amsterdam/wonen-ui": "^1.0.82",
    "axios": "^1.16.1",
    "dayjs": "^1.11.13",
    "final-form": "^4.20.10",
    "final-form-arrays": "^3.0.2",
    "immer": "^11.1.3",
    "jwt-decode": "^4.0.0",
    "lodash.debounce": "^4.0.8",
    "lodash.isempty": "^4.4.0",
    "lodash.merge": "^4.6.2",
    "qs": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-final-form": "^6.5.9",
    "react-final-form-arrays": "^3.1.4",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.30.3",
    "react-tooltip": "^6.0.3",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@types/lodash.debounce": "^4.0.7",
    "@types/lodash.isempty": "^4.4.7",
    "@types/lodash.merge": "^4.6.7",
    "@types/node": "^26.1.2",
    "@types/qs": "^6.15.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.26",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-config-react-app": "^7.0.1",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.0"
  }
}
